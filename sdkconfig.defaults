CONFIG_FREERTOS_HZ=1000
CONFIG_ESP_MAIN_TASK_STACK_SIZE=4096
CONFIG_ESP_SYSTEM_EVENT_TASK_STACK_SIZE=4096
CONFIG_LWIP_MAX_SOCKETS=12
CONFIG_HTTPD_MAX_REQ_HDR_LEN=1024
CONFIG_ETH_ENABLED=y
CONFIG_ETH_USE_ESP32_EMAC=y

# The RMII clock source and GPIO used to be Kconfig options
# (CONFIG_ETH_RMII_CLK_INPUT / CONFIG_ETH_RMII_CLK_IN_GPIO). ESP-IDF 6.0
# removed them -- both are now set at runtime in init_ethernet() via
# clock_config.rmii.clock_mode and .clock_gpio. Leaving them here would be
# silently ignored, which is worse than not having them.
